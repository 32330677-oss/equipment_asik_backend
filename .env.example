# ---------------------------------------------------------------- Equipment Flow (ASIK) backend
# Copy this file to .env and fill the values. Never commit .env.

NODE_ENV=development
# Different port from your other local project (Team Flow uses 5000).
PORT=5055

# ---------------------------------------------------------------- MySQL (separate database!)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=equipment_asik_user
DB_PASSWORD=change-me-strong-password
DB_NAME=equipment_asik
DB_SSL=false
# Only for `npm run db:init` (creates the database + the user above with rights on equipment_asik ONLY).
# Leave empty to create the database with DB_USER itself.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------- Security
# 64 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Comma separated origins allowed to call the API (* = any, fine for local development)
CORS_ORIGINS=*
LOGIN_RATE_LIMIT_MAX=20
BCRYPT_COST=12

# ---------------------------------------------------------------- Business time zone (Syria: UTC+3 all year)
APP_TIME_ZONE=Asia/Damascus

# ---------------------------------------------------------------- Files (contracts, photos, paper scans, receipts)
# local = folder on this machine (default ./storage). Use s3 in production on hosts without a persistent disk.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_DIR=
# s3 / Cloudflare R2:
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Team Flow integration (read-only)
# Shared secret that Team Flow sends to read the daily plant summary for the combined Project Daily Report.
# 32+ random characters; put the SAME value in Team Flow's EQUIPMENT_INTEGRATION_TOKEN. Empty = integration off.
INTEGRATION_TOKEN=

# ---------------------------------------------------------------- Telegram bot for site supervisors (optional)
# Its own bot from @BotFather (not Team Flow's). Off unless TELEGRAM_BOT_ENABLED=true and the values below are set.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# the bot's username without @, e.g. asik_equipment_bot
TELEGRAM_BOT_USERNAME=
# 16+ random characters; Telegram sends it back on every update
TELEGRAM_WEBHOOK_SECRET=
# the public https address of this server: the webhook is registered with Telegram on every start
PUBLIC_BASE_URL=
# AI that reads the supervisors' messages (this server's own key, not Team Flow's). Without it the bot only shows status.
# OPENAI_API_KEY is also used for voice notes.
OPENAI_API_KEY=
# optional: BOT_AI_PROVIDER=openai|anthropic, ANTHROPIC_API_KEY, BOT_AI_MODEL (default gpt-4.1-mini),
# BOT_AI_STRONG_MODEL (second look, default gpt-4.1; off = never), BOT_STT_MODEL (default gpt-4o-mini-transcribe),
# BOT_DAILY_LIMIT (AI reads per supervisor per day, default 150)
# BOT_KEEP_CHAT_DAYS (days the bot conversations are kept for the Admin, default 30; 0 = not kept)
